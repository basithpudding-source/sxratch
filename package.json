{
  "name": "sxratch",
  "version": "0.1.0",
  "description": "Sxratch — a browser-based DJ app for scratching and mixing on desktop and mobile.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node build.js",
    "deploy": "node --test && node build.js && firebase deploy --only hosting",
    "start:dist": "node server.js --dist",
    "test": "node --test",
    "icons": "node scripts/make-icons.js",
    "samples": "node scripts/fetch-samples.js"
  },
  "keywords": [
    "dj",
    "scratch",
    "turntable",
    "web-audio",
    "audioworklet",
    "mixer"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "sharp": "^0.35.2"
  }
}
