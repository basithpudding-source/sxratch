{
  "name": "sxratch",
  "version": "0.1.0",
  "description": "Sxratch — a browser-based DJ app for scratching and mixing on desktop and mobile.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node build.js",
    "deploy": "npm test && node build.js && firebase deploy --only hosting",
    "start:dist": "node server.js --dist",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm test && npm run test:e2e",
    "icons": "node scripts/make-icons.js"
  },
  "keywords": [
    "dj",
    "scratch",
    "turntable",
    "web-audio",
    "audioworklet",
    "mixer"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.1",
    "sharp": "^0.35.2"
  }
}
